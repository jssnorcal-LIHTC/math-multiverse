    {
      "itemId": "l4-todigits-8-13",
      "itemHash": "3ef298b77c4f1ca8",
      "blind": 0,
      "authored": 1,
      "confidence": "high",
      "status": "adjudicated",
      "note": "The authored key stands.  \"Eight and thirteen HUNDREDTHS\" puts thirteen in the hundredths place, which is two digits after the point, so the number is 8.13.  The blind read chose 8.013, which is eight and thirteen THOUSANDTHS and is what that option exists to catch:  it is the exact place-name error this item is built around, and the distractor rationale on it says so.  The place name at the end of the words is the only thing that fixes how many digits belong after the point, and reading it as thousandths is the misconception, not an alternative reading.",
      "adjudicatedBy": "Justin Solomon (via Claude Code, 26-0822 WP2 L4)",
      "adjudicatedAt": "2026-08-22"
